{
  "name": "image-toolkit-tool-kits",
  "version": "1.0.0",
  "private": true,
  "description": "全能工具箱微信小程序（Taro + Skyline + 微信云开发内容安全）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "node scripts/sync-wechat-env.mjs && taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package-size": "node scripts/check-package-size.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build:weapp && pnpm check:package-size"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "^2.7.14",
    "@tarojs/components": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-react": "4.0.9",
    "@tarojs/plugin-html": "4.0.9",
    "@tarojs/plugin-platform-weapp": "4.0.9",
    "@tarojs/react": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/shared": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "relationship.js": "1.2.9"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/cli": "4.0.9",
    "@tarojs/taro-loader": "4.0.9",
    "@tarojs/webpack5-runner": "4.0.9",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-preset-taro": "4.0.9",
    "eslint": "^8.57.0",
    "less": "4.2.0",
    "postcss": "^8.5.19",
    "react-refresh": "0.14.2",
    "sass": "^1.75.0",
    "typescript": "^5.4.5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "webpack": "5.91.0"
  }
}
